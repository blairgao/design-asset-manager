# Copy to .env for local development. Values here match docker-compose.yml.
DAM_ENV=dev
DAM_SECRET_KEY=change-me-to-a-long-random-string
DAM_BASE_URL=http://localhost:8000
DAM_WEB_ORIGIN=http://localhost:5173

DAM_DATABASE_URL=postgresql+asyncpg://dam:dam@localhost:5432/dam
DAM_REDIS_URL=redis://localhost:6379/0

# S3. In production leave the endpoint empty and use an IAM role.
DAM_S3_BUCKET=dam-dev
DAM_S3_REGION=us-east-1
DAM_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Optional CloudFront distribution for derived files (previews/thumbnails).
DAM_CLOUDFRONT_DOMAIN=
DAM_CLOUDFRONT_KEY_ID=
DAM_CLOUDFRONT_PRIVATE_KEY_PATH=

# Models. ANTHROPIC_API_KEY is read by the SDK; only the worker needs it.
ANTHROPIC_API_KEY=
DAM_VISION_MODEL=claude-opus-5-5
DAM_EMBEDDING_PROVIDER=voyage        # voyage | fake
VOYAGE_API_KEY=
DAM_EMBEDDING_MODEL=voyage-multimodal-3
DAM_EMBEDDING_DIM=1024

# Email. "console" prints magic links to the log.
DAM_MAIL_BACKEND=console              # console | smtp
DAM_SMTP_HOST=
DAM_SMTP_PORT=587
DAM_SMTP_USER=
DAM_SMTP_PASSWORD=
DAM_MAIL_FROM=no-reply@example.com
